// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  SALES
  SERVICE
  PARTS
}

enum Department {
  SALES
  SERVICE
  PARTS
  FINANCE
  GENERAL
}

enum ConversationStatus {
  OPEN
  WAITING_ON_CUSTOMER
  WAITING_ON_STAFF
  FOLLOW_UP_NEEDED
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum MessageKind {
  SMS
  MMS
  NOTE
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  RECEIVED
  INTERNAL
}

enum PreferredContactMethod {
  SMS
  PHONE
  EMAIL
}

enum VehicleRelationship {
  OWNED
  INTERESTED
  TRADE_IN
  SERVICE_UNIT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// Consent is a ledger, not a flag. See src/lib/consent.ts, which classifies
// every method and derives the status the Customer caches.
enum SmsConsentStatus {
  NONE
  GRANTED
  REVOKED
}

enum ConsentChannel {
  SMS
}

enum ConsentEventKind {
  GRANTED
  REVOKED
}

enum ConsentMethod {
  CUSTOMER_TEXTED_FIRST
  KEYWORD_START
  KEYWORD_STOP
  STAFF_RECORDED_REQUEST
  VERBAL_AT_COUNTER
  WRITTEN_FORM
  PROVIDER_BLOCK
  STAFF_CORRECTION
  BACKFILL_FIRST_INBOUND
  BACKFILL_LEGACY_FLAG
  SEED
}

enum AiInsightActionType {
  GENERATED
  ACCEPTED
  DISMISSED
  NOTE_CREATED
  FOLLOW_UP_CREATED
  REPLY_COPIED
}

enum ProductEventType {
  AI_INSIGHT_REQUESTED
  AI_INSIGHT_GENERATED
  AI_INSIGHT_FAILED
  AI_RECOMMENDATION_ACCEPTED
  AI_RECOMMENDATION_DISMISSED
  AI_NOTE_CREATED
  AI_FOLLOW_UP_CREATED
  AI_REPLY_COPIED
}

enum NotificationType {
  NEW_INBOUND_MESSAGE
  CONVERSATION_ASSIGNED
  CONVERSATION_REASSIGNED
  FOLLOW_UP_DUE
  FOLLOW_UP_OVERDUE
  MESSAGE_FAILED
  SLA_MISSED
  UNASSIGNED_CONVERSATION
}

enum NotificationStatus {
  UNREAD
  READ
  RESOLVED
}

model User {
  id              String      @id @default(cuid())
  name            String
  email           String      @unique
  passwordHash    String
  role            Role
  department      Department?
  active          Boolean     @default(true)
  // The moment this account last lost its existing sessions: an admin switched
  // it off, or reset its password while it was active. Sessions minted at or
  // before it are refused for good, so neither reactivating nor carrying on
  // after a reset wakes an old browser tab back up. Settings reads it as the
  // "access ended" time, and shows it only for inactive accounts - on a live
  // account it marks a reset, which is not access ending. A reset stamps it
  // only while the account is active, so resetting the password of an
  // already-deactivated account leaves its deactivation record intact.
  accessEndedAt   DateTime?
  // The last request this account was allowed through on, so an admin can see
  // that nothing succeeded after access ended. Only granted requests move it.
  lastSeenAt      DateTime?
  // Who is holding this account's open conversations while they are away, and
  // from when. Both are set when coverage begins, or neither is: `coveredSince`
  // is the instant the return rule measures a reply against, so a cover with no
  // start is a coverage nobody can end correctly. After that they part company.
  // `coveredByUserId` follows the threads, so a chained hand-off re-points it at
  // whoever is holding them now. `coveredSince` must NOT move: it is when this
  // account's own trip began, and only the cover now holding a thread has her
  // replies counted, so advancing it to a chained hand-off would drop one she
  // sent on that thread before it reached her - handing back a conversation the
  // customer has already heard her on. When a chained hand-off happened is
  // recorded in AuditLog. A permanent hand-off leaves both null - there is
  // nothing to return.
  coveredByUserId String?
  coveredSince    DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  coveredBy User?  @relation("Coverage", fields: [coveredByUserId], references: [id], onDelete: SetNull)
  covering  User[] @relation("Coverage")

  coveredConversations  Conversation[]          @relation("CoveredConversations")
  assignedConversations Conversation[]          @relation("AssignedConversations")
  sentMessages          Message[]               @relation("SentMessages")
  recordedConsentEvents ConsentEvent[]          @relation("RecordedConsentEvents")
  assignedTasks         Task[]                  @relation("AssignedTasks")
  notifications         Notification[]          @relation("NotificationRecipient")
  actorNotifications    Notification[]          @relation("NotificationActor")
  auditLogs             AuditLog[]
  aiInsights            ConversationAiInsight[]
  productEvents         ProductEvent[]
}

model DealershipSettings {
  id             String   @id @default("default")
  dealershipName String
  salesPhone     String?
  servicePhone   String?
  partsPhone     String?
  websiteUrl     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Customer {
  id                     String                 @id @default(cuid())
  name                   String
  phone                  String                 @unique
  email                  String?
  preferredContactMethod PreferredContactMethod @default(SMS)
  // A cache of consentState over this customer's ConsentEvent rows, written
  // only by recordConsentEvent in src/lib/consent-ledger.ts, in the event's own
  // transaction. NONE by default: a row created without a GRANTED event is not
  // textable. smsConsentEventId names the event the status rests on.
  smsConsent             SmsConsentStatus       @default(NONE)
  smsConsentEventId      String?                @unique
  notes                  String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  vehicles        CustomerVehicle[]
  conversations   Conversation[]
  tasks           Task[]
  consentEvents   ConsentEvent[]    @relation("CustomerConsentEvents")
  smsConsentEvent ConsentEvent?     @relation("CustomerCurrentConsent", fields: [smsConsentEventId], references: [id], onDelete: Restrict)
}

model CustomerVehicle {
  id           String              @id @default(cuid())
  customerId   String
  year         Int
  make         String
  model        String
  vin          String?
  stockNumber  String?
  mileage      Int?
  relationship VehicleRelationship
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Conversation {
  id               String             @id @default(cuid())
  customerId       String
  assignedUserId   String?
  // The advisor this thread belongs to while somebody else is holding it. Set
  // only for coverage that can end; a permanent hand-off moves the assignee and
  // leaves this null, because there is nobody for it to go back to.
  coveredForUserId String?
  department       Department
  status           ConversationStatus @default(OPEN)
  priority         Priority           @default(NORMAL)
  subject          String?
  unread           Boolean            @default(false)
  lastMessageAt    DateTime           @default(now())
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  customer      Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedUser  User?                   @relation("AssignedConversations", fields: [assignedUserId], references: [id], onDelete: SetNull)
  coveredFor    User?                   @relation("CoveredConversations", fields: [coveredForUserId], references: [id], onDelete: SetNull)
  messages      Message[]
  tasks         Task[]
  tags          ConversationTag[]
  notifications Notification[]
  aiInsights    ConversationAiInsight[]
  productEvents ProductEvent[]

  @@index([customerId])
  @@index([assignedUserId])
  @@index([coveredForUserId])
  @@index([department, status])
  @@index([lastMessageAt])
}

model Message {
  id              String           @id @default(cuid())
  conversationId  String
  senderUserId    String?
  direction       MessageDirection
  kind            MessageKind      @default(SMS)
  body            String
  mediaUrl        String?
  deliveryStatus  DeliveryStatus   @default(QUEUED)
  errorMessage    String?
  twilioSid       String?          @unique
  /// True when Attend wrote this row itself, rather than a person typing it.
  /// Only internal notes are ever marked; it is what lets the breach rule tell
  /// "somebody did something about this customer" from its own bookkeeping.
  systemGenerated Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  conversation  Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender        User?          @relation("SentMessages", fields: [senderUserId], references: [id], onDelete: SetNull)
  notifications Notification[]
  consentEvents ConsentEvent[]

  @@index([conversationId, createdAt])
}

model Template {
  id         String     @id @default(cuid())
  name       String
  department Department
  body       String
  variables  Json
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([department, active])
}

model Task {
  id             String     @id @default(cuid())
  title          String
  description    String?
  customerId     String
  conversationId String?
  assignedUserId String?
  department     Department
  dueDate        DateTime
  priority       Priority   @default(NORMAL)
  status         TaskStatus @default(OPEN)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversation  Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignedUser  User?          @relation("AssignedTasks", fields: [assignedUserId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([assignedUserId])
  @@index([customerId])
  @@index([conversationId])
  @@index([dueDate, status])
}

model Tag {
  id            String            @id @default(cuid())
  name          String            @unique
  color         String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  conversations ConversationTag[]
}

model ConversationTag {
  conversationId String
  tagId          String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
}

// Append-only: no writer updates or deletes a row (tests/consent.test.ts scans
// for one). A correction is a new STAFF_CORRECTION event. Customer
// deletion is restricted so a STOP outlives the row it was recorded against,
// and the phone is copied on so the evidence survives a phone edit. The pairing
// of method to kind, and the recorder and evidence a staff-recorded method
// requires, are CHECK constraints that exist only in
// migrations/20260925090000_consent_ledger (Prisma cannot express them).
model ConsentEvent {
  id               String           @id @default(cuid())
  customerId       String
  // E.164, copied at write time: consent attaches to a number.
  phone            String
  channel          ConsentChannel   @default(SMS)
  kind             ConsentEventKind
  method           ConsentMethod
  // The inbound text that is the evidence, when there is one.
  messageId        String?
  // The staff member who recorded it; required for staff-recorded methods.
  recordedByUserId String?
  // What the customer said or signed; required for staff-recorded methods.
  evidence         String?
  // When the customer acted, which is what orders the ledger.
  occurredAt       DateTime
  createdAt        DateTime         @default(now())
  // A Twilio message sid or OptOutType, when the provider supplied one.
  providerRef      String?

  customer   Customer  @relation("CustomerConsentEvents", fields: [customerId], references: [id], onDelete: Restrict)
  message    Message?  @relation(fields: [messageId], references: [id], onDelete: SetNull)
  recordedBy User?     @relation("RecordedConsentEvents", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  currentFor Customer? @relation("CustomerCurrentConsent")

  @@index([customerId, occurredAt])
  @@index([phone, occurredAt])
}

// One recipient holds at most one active (UNREAD or READ) copy of an alert. That
// is a unique index Prisma's schema language cannot express - partial, over
// COALESCEd columns - so it lives only in
// migrations/20260916090000_one_active_copy_of_an_alert, and `migrate diff`
// ignores it. `createIfMissingWithClient` in src/lib/notifications.ts relies on it.
model Notification {
  id              String             @id @default(cuid())
  type            NotificationType
  status          NotificationStatus @default(UNREAD)
  title           String
  body            String?
  recipientUserId String?
  actorUserId     String?
  conversationId  String?
  taskId          String?
  messageId       String?
  department      Department?
  priority        Priority           @default(NORMAL)
  dueAt           DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  recipientUser User?         @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  actorUser     User?         @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  conversation  Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  task          Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  message       Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, status, createdAt])
  @@index([type, status, createdAt])
  @@index([department, status, createdAt])
  @@index([conversationId])
  @@index([taskId])
}

model ConversationAiInsight {
  id                    String      @id @default(cuid())
  conversationId        String
  requestedByUserId     String?
  model                 String
  summary               String
  customerNeed          String
  riskLevel             Priority
  riskReasons           Json
  escalationRecommended Boolean     @default(false)
  escalationReason      String?
  suggestedDepartment   Department?
  suggestedNextAction   String
  suggestedReply        String?
  suggestedTaskTitle    String?
  confidence            Int
  createdAt             DateTime    @default(now())
  acceptedAt            DateTime?
  dismissedAt           DateTime?

  conversation Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestedBy  User?          @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)
  events       ProductEvent[]

  @@index([conversationId, createdAt])
  @@index([riskLevel, createdAt])
}

model ProductEvent {
  id             String           @id @default(cuid())
  type           ProductEventType
  userId         String?
  conversationId String?
  aiInsightId    String?
  metadata       Json?
  createdAt      DateTime         @default(now())

  user         User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversation Conversation?          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  aiInsight    ConversationAiInsight? @relation(fields: [aiInsightId], references: [id], onDelete: Cascade)

  @@unique([type, aiInsightId])
  @@index([type, createdAt])
  @@index([conversationId, createdAt])
  @@index([aiInsightId])
}
